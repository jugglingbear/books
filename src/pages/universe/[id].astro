---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import { base, catalog, inSeries, inUniverse, seriesUrl } from "../../lib/books";
export async function getStaticPaths() {
  const { universes } = await catalog();
  return universes.map((universe) => ({ params: { id: universe.id }, props: { universe } }));
}
const { universe } = Astro.props;
const { books, series } = await catalog();
const items = inUniverse(books, universe.data.title);
const groups = series.map((item) => ({ title: item.data.title, url: seriesUrl(item), books: inSeries(items, item.data.title) }))
  .filter((group) => group.books.length > 0);
groups.push({ title: "Standalones & short fiction", url: "", books: items.filter((book) => !book.data.series && book.data.kind !== "Collection") });
groups.push({ title: "Collections", url: "", books: items.filter((book) => !book.data.series && book.data.kind === "Collection") });
const related = books.filter((book) => universe.data.relatedBooks.includes(book.id));
const { Content } = await render(universe);
---
<Layout title={`${universe.data.title} · The Library`} active="series">
  <div class="wrap universe-page">
    <header class="series-hero">
      <a class="back-link" href={`${base}/series/`}>← Series & universes</a>
      <span class="eyebrow">SHARED UNIVERSE · {items.length} TITLES IN THE LIBRARY</span>
      <h1>{universe.data.title}</h1>
      <p class="intro">{universe.data.author}</p>
      <div class="prose"><Content/></div>
      <p class="intro">These are the titles on my shelves, rather than a complete bibliography or a required reading order.
        Collections may include stories also held individually.</p>
      <a class="text-link" href={`${base}/?universe=${encodeURIComponent(universe.data.title)}#library`}>Search and filter this universe →</a>
    </header>
    <nav class="universe-jump" aria-label="Shelves in this universe">
      {groups.filter((group) => group.books.length).map((group, index) => <a href={`#shelf-${index}`}>{group.title}</a>)}
      {related.length > 0 && <a href="#related-drafts">Related drafts</a>}
    </nav>
    {groups.filter((group) => group.books.length).map((group, index) => <section class="universe-shelf" id={`shelf-${index}`}>
      <div class="library-heading"><div><span class="eyebrow">{group.books.length} {group.books.length === 1 ? "TITLE" : "TITLES"} ON MY SHELF</span>
        <h2>{group.title}</h2></div>{group.url && <a class="text-link" href={group.url}>Explore the series →</a>}</div>
      <div class="book-grid">{group.books.map((book) => <BookCard book={book}/>)}</div>
    </section>)}
    {related.length > 0 && <section class="universe-shelf" id="related-drafts">
      <div class="library-heading"><div><span class="eyebrow">RELATED · NON-CANON</span><h2>Earlier paths, other possibilities.</h2></div></div>
      <p class="intro">These {related.length} early drafts offer a glimpse of stories taking shape. They are separate from
        the established continuity and the {items.length} titles counted above.</p>
      <div class="book-grid">{related.map((book) => <BookCard book={book}/>)}</div>
    </section>}
    <p class="source-note">{universe.data.sources.map((source) => <a href={source.url}>{source.label} ↗</a>)}</p>
  </div>
</Layout>
