---
import Icon from "./Icon.astro";
import { statusLabel } from "../lib/catalog.mjs";
interface Props { read: boolean | null; listened: boolean; queued?: boolean; }
const { read, listened, queued = false } = Astro.props;
---
<span class:list={["status", { both: read && listened }]}>
  {read && <Icon name="book" />}{listened && <Icon name="headphones" />}
  {statusLabel(read, listened)}
</span>
{queued && <span class="status">In queue</span>}
