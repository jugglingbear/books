---
interface Props { sources: ("Audible" | "GraphicAudio")[]; }
const { sources } = Astro.props;
---
{sources.length > 0 && <span class="audio-sources" aria-label="Audiobook editions">
  {sources.map((source) => <span class:list={["audio-source", source === "Audible" ? "audible" : "graphic-audio"]} title={`${source} audiobook edition`}>
    <span class="audio-source-mark" aria-hidden="true">{source === "Audible" ? "A" : "GA"}</span>{source}
  </span>)}
</span>}
