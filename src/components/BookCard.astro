---
import Cover from "./Cover.astro";
import AudioSources from "./AudioSources.astro";
import Status from "./Status.astro";
import { bookUrl, type Book } from "../lib/books";
interface Props { book: Book; }
const { book } = Astro.props;
---
<article class="book-card" data-book data-title={book.data.title} data-author={book.data.author} data-series={book.data.series} data-read={String(book.data.read)} data-listened={String(book.data.listened)}>
  <a href={bookUrl(book)} class="book-cover-link" aria-label={`View ${book.data.title} by ${book.data.author}`}><Cover book={book}/></a>
  <div class="book-meta">
    <p class="series-label">{book.data.series || book.data.kind}</p>
    <h3><a href={bookUrl(book)}>{book.data.title}</a></h3>
    <p class="author">{book.data.author}</p>
    <Status read={book.data.read} listened={book.data.listened}/>
      <AudioSources sources={book.data.audioSources}/>
  </div>
</article>
